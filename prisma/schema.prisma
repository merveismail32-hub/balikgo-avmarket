generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  SELLER
  ADMIN
}

enum SellerStatus {
  PENDING
  APPROVED
  REJECTED
}

enum OrderStatus {
  NEW
  PREPARING
  READY_TO_SHIP
  SHIPPED
  COMPLETED
  DELIVERED
  CANCELLED
  RETURN_REQUESTED
  RETURNED
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  PAID
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PayoutStatus {
  PENDING
  BLOCKED
  AVAILABLE
  SCHEDULED
  PAID
  CANCELLED
}

enum LedgerEntryType {
  SALE
  COMMISSION
  PROVIDER_FEE
  PAYOUT
  REFUND
  ADJUSTMENT
}

model User {
  id            String         @id @default(cuid())
  name          String
  surname       String
  email         String         @unique
  phone         String
  passwordHash  String
  role          UserRole       @default(CUSTOMER)
  sellerProfile SellerProfile?
  cartItems     CartItem[]
  favorites     Favorite[]
  orders        Order[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model SellerProfile {
  id          String       @id @default(cuid())
  userId      String       @unique
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  storeName   String
  storeSlug   String?      @unique
  companyType String
  phone       String       @default("")
  taxNumber   String
  taxOffice   String
  city        String
  address     String
  description String
  categories  String       @default("")
  status      SellerStatus @default(PENDING)
  rejectionReason String?  @db.VarChar(500)
  products    Product[]
  orderItems  OrderItem[]
  payouts     SellerPayout[]
  ledgerEntries FinancialLedgerEntry[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Product {
  id          String        @id @default(cuid())
  sellerId    String
  seller      SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  name        String
  slug        String        @unique
  category    String
  brand       String
  price       Decimal       @db.Decimal(12, 2)
  oldPrice    Decimal?      @db.Decimal(12, 2)
  stock       Int           @default(0)
  description String
  imageUrl    String
  images      Json?
  technicalDetails String  @default("")
  shippingInfo     String  @default("")
  badge       String        @default("")
  discount    Int           @default(0)
  rating      Float         @default(0)
  reviewCount Int           @default(0)
  active      Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  cartItems   CartItem[]
  favoritedBy Favorite[]
  orderItems   OrderItem[]
}

model Order {
  id              String      @id @default(cuid())
  userId          String
  user            User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  orderNumber     String      @unique
  clientRequestId String      @unique
  totalAmount     Decimal     @db.Decimal(12, 2)
  status          OrderStatus @default(NEW)
  recipientName   String
  phone           String
  city            String
  district        String
  address         String
  postalCode      String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  items           OrderItem[]
  payment         Payment?
  payouts         SellerPayout[]

  @@index([userId, createdAt])
}

model OrderItem {
  id              String        @id @default(cuid())
  orderId         String
  productId       String
  sellerId        String
  productName     String
  productImageUrl String
  unitPrice       Decimal       @db.Decimal(12, 2)
  quantity        Int
  status          OrderStatus   @default(NEW)
  shippingCompany String?
  trackingNumber  String?
  commissionRate  Decimal?       @db.Decimal(5, 4)
  commissionAmount Decimal?      @db.Decimal(12, 2)
  sellerNetAmount Decimal?       @db.Decimal(12, 2)
  order           Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  statusHistory   OrderStatusHistory[]
  payout          SellerPayout?
  ledgerEntries   FinancialLedgerEntry[]
  product         Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  seller          SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([sellerId, createdAt])
  @@index([orderId])
}

model Payment {
  id                String        @id @default(cuid())
  orderId           String        @unique
  provider          String        @default("TEST_PENDING")
  providerPaymentId String?       @unique
  amount            Decimal       @db.Decimal(12, 2)
  currency          String        @default("TRY") @db.VarChar(3)
  status            PaymentStatus @default(PENDING)
  paymentMethod     String?       @db.VarChar(80)
  metadata          Json?
  paidAt            DateTime?
  failedAt          DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  order             Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model SellerPayout {
  id                String       @id @default(cuid())
  sellerId          String
  orderId           String
  orderItemId       String       @unique
  grossAmount       Decimal      @db.Decimal(12, 2)
  commissionAmount  Decimal      @db.Decimal(12, 2)
  providerFeeAmount Decimal      @default(0) @db.Decimal(12, 2)
  netAmount         Decimal      @db.Decimal(12, 2)
  currency          String       @default("TRY") @db.VarChar(3)
  status            PayoutStatus @default(PENDING)
  availableAt       DateTime?
  paidAt            DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  seller            SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  order             Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItem         OrderItem    @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  ledgerEntries     FinancialLedgerEntry[]
  @@index([sellerId, status, createdAt])
}

model FinancialLedgerEntry {
  id           String          @id @default(cuid())
  sellerId     String
  orderItemId  String
  payoutId     String?
  type         LedgerEntryType
  amount       Decimal         @db.Decimal(12, 2)
  currency     String          @default("TRY") @db.VarChar(3)
  createdAt    DateTime        @default(now())
  seller       SellerProfile   @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  orderItem    OrderItem       @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  payout       SellerPayout?   @relation(fields: [payoutId], references: [id], onDelete: SetNull)
  @@index([sellerId, createdAt])
  @@index([orderItemId, type])
}

model OrderStatusHistory {
  id          String      @id @default(cuid())
  orderItemId String
  fromStatus  OrderStatus?
  toStatus    OrderStatus
  createdAt   DateTime    @default(now())
  orderItem   OrderItem   @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  @@index([orderItemId, createdAt])
}

model CartItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  quantity  Int      @default(1)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, productId])
  @@index([userId])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  productId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId])
}
