generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  SELLER
  ADMIN
}

enum SellerStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum ProductModerationStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CatalogMatchStatus {
  EXACT_GTIN_MATCH
  SELLER_SKU_MATCH
  NEW_CATALOG_PRODUCT
  REVIEW_REQUIRED
  CONFLICT
}

enum CatalogMatchReviewStatus {
  PENDING
  RESOLVED
  REJECTED
}

enum CouponDiscountType {
  PERCENTAGE
  FIXED
}

enum CouponScope {
  PLATFORM
  SELLER
}

enum OrderStatus {
  NEW
  PREPARING
  READY_TO_SHIP
  SHIPPED
  COMPLETED
  DELIVERED
  CANCELLED
  RETURN_REQUESTED
  RETURNED
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  PAID
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
  REFUND_PENDING
  PARTIAL_REFUND_PENDING
}

enum PayoutStatus {
  PENDING
  BLOCKED
  AVAILABLE
  SCHEDULED
  PAID
  CANCELLED
}

enum LedgerEntryType {
  SALE
  COMMISSION
  PROVIDER_FEE
  PAYOUT
  REFUND
  ADJUSTMENT
  SALE_REVERSAL
  COMMISSION_REVERSAL
}

enum RefundStatus {
  REQUESTED
  APPROVED
  PROCESSING
  COMPLETED
  REJECTED
  FAILED
  CANCELLED
}

enum NotificationStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  CANCELLED
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
  WHATSAPP
  PUSH
}

enum ShipmentStatus {
  NOT_READY
  PREPARING
  READY_TO_SHIP
  SHIPPED
  DELIVERED
  CANCELLED
}

enum StockMovementType {
  CHECKOUT_DECREMENT
  CANCELLATION_RESTORE
  SELLER_ABSOLUTE_SET
}

model User {
  id                 String                @id @default(cuid())
  name               String
  surname            String
  email              String                @unique
  phone              String
  passwordHash       String
  role               UserRole              @default(CUSTOMER)
  sellerProfile      SellerProfile?
  cartItems          CartItem[]
  favorites          Favorite[]
  orders             Order[]
  orderStatusChanges OrderStatusHistory[]
  refundsRequested   Refund[]              @relation("RefundRequester")
  financialAudits    FinancialAuditEvent[]
  notifications      Notification[]
  reviews            Review[]
  couponRedemptions  CouponRedemption[]
  adminAudits        AdminAuditLog[]
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
}

model SellerProfile {
  id                  String                 @id @default(cuid())
  userId              String                 @unique
  user                User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  storeName           String
  storeSlug           String?                @unique
  companyType         String
  phone               String                 @default("")
  taxNumber           String
  taxOffice           String
  city                String
  address             String
  description         String
  categories          String                 @default("")
  status              SellerStatus           @default(PENDING)
  rejectionReason     String?                @db.VarChar(500)
  products            Product[]
  offers              SellerOffer[]
  catalogMatchReviews CatalogMatchReview[]
  orderItems          OrderItem[]
  payouts             SellerPayout[]
  refunds             Refund[]
  notifications       Notification[]
  coupons             Coupon[]
  ledgerEntries       FinancialLedgerEntry[]
  shipments           Shipment[]
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
}

model Product {
  id               String                  @id @default(cuid())
  sellerId         String
  catalogProductId String?
  seller           SellerProfile           @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  catalogProduct   CatalogProduct?         @relation(fields: [catalogProductId], references: [id], onDelete: SetNull)
  sellerOffer      SellerOffer?            @relation("LegacyProductOffer")
  name             String
  sku              String?                 @db.VarChar(80)
  slug             String                  @unique
  category         String
  brand            String
  categoryId       String?
  brandId          String?
  price            Decimal                 @db.Decimal(12, 2)
  oldPrice         Decimal?                @db.Decimal(12, 2)
  stock            Int                     @default(0)
  description      String
  imageUrl         String
  images           Json?
  technicalDetails String                  @default("")
  shippingInfo     String                  @default("")
  badge            String                  @default("")
  discount         Int                     @default(0)
  rating           Float                   @default(0)
  reviewCount      Int                     @default(0)
  active           Boolean                 @default(true)
  moderationStatus ProductModerationStatus @default(APPROVED)
  moderationReason String?                 @db.VarChar(500)
  moderatedAt      DateTime?
  categoryRecord   Category?               @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  brandRecord      Brand?                  @relation(fields: [brandId], references: [id], onDelete: SetNull)
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  cartItems        CartItem[]
  favoritedBy      Favorite[]
  orderItems       OrderItem[]
  reviews          Review[]
  stockMovements   StockMovement[]

  @@unique([sellerId, sku])
  @@index([moderationStatus, active, createdAt])
  @@index([categoryId])
  @@index([brandId])
  @@index([catalogProductId])
}

model CatalogProduct {
  id               String                  @id @default(cuid())
  slug             String                  @unique
  name             String
  brand            String
  category         String
  categoryId       String?
  brandId          String?
  model            String?                 @db.VarChar(160)
  barcode          String?                 @unique @db.VarChar(32)
  normalizedGtin   String?                 @unique @db.VarChar(14)
  normalizedName   String?                 @db.VarChar(191)
  normalizedBrand  String?                 @db.VarChar(160)
  normalizedModel  String?                 @db.VarChar(160)
  variantKey       String?                 @db.VarChar(191)
  identityKey      String?                 @unique @db.VarChar(191)
  description      String
  imageUrl         String
  images           Json?
  technicalDetails String                  @default("")
  shippingInfo     String                  @default("")
  badge            String                  @default("")
  rating           Float                   @default(0)
  reviewCount      Int                     @default(0)
  active           Boolean                 @default(true)
  moderationStatus ProductModerationStatus @default(APPROVED)
  moderationReason String?                 @db.VarChar(500)
  moderatedAt      DateTime?
  categoryRecord   Category?               @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  brandRecord      Brand?                  @relation(fields: [brandId], references: [id], onDelete: SetNull)
  legacyProducts   Product[]
  offers           SellerOffer[]
  matchReviews     CatalogMatchReview[]
  cartItems        CartItem[]
  favorites        Favorite[]
  reviews          Review[]
  orderItems       OrderItem[]
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  @@index([moderationStatus, active, createdAt])
  @@index([categoryId])
  @@index([brandId])
  @@index([brand, model, variantKey])
  @@index([normalizedBrand, normalizedModel, normalizedName])
}

model SellerOffer {
  id               String              @id @default(cuid())
  sellerId         String
  catalogProductId String
  legacyProductId  String?             @unique
  sellerSku        String?             @db.VarChar(80)
  price            Decimal             @db.Decimal(12, 2)
  listPrice        Decimal?            @db.Decimal(12, 2)
  stock            Int                 @default(0)
  inventoryVersion Int                @default(0)
  active           Boolean             @default(true)
  handlingTimeDays Int                 @default(0)
  source           String?             @db.VarChar(50)
  externalSourceId String?             @db.VarChar(191)
  matchStatus      CatalogMatchStatus?
  matchReason      String?             @db.VarChar(100)
  matchConfidence  Decimal?            @db.Decimal(5, 4)
  seller           SellerProfile       @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  catalogProduct   CatalogProduct      @relation(fields: [catalogProductId], references: [id], onDelete: Restrict)
  legacyProduct    Product?            @relation("LegacyProductOffer", fields: [legacyProductId], references: [id], onDelete: SetNull)
  cartItems        CartItem[]
  orderItems       OrderItem[]
  matchReviews     CatalogMatchReview[]
  stockMovements   StockMovement[]
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@unique([sellerId, catalogProductId])
  @@unique([sellerId, sellerSku])
  @@unique([sellerId, source, externalSourceId])
  @@index([catalogProductId, active, stock])
  @@index([sellerId, active, updatedAt])
}

model StockMovement {
  id                     String            @id @default(cuid())
  sellerOfferId          String
  productId              String?
  orderId                String?
  orderItemId            String?
  paymentId              String?
  refundId               String?
  actorUserId            String?
  actorSellerId          String?
  type                   StockMovementType
  quantityDelta          Int
  stockBefore            Int
  stockAfter             Int
  inventoryVersionBefore Int
  inventoryVersionAfter  Int
  idempotencyKey         String            @unique @db.VarChar(191)
  source                 String            @db.VarChar(50)
  createdAt              DateTime          @default(now())
  sellerOffer            SellerOffer       @relation(fields: [sellerOfferId], references: [id], onDelete: Restrict)
  product                Product?          @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([sellerOfferId, createdAt])
  @@index([orderItemId, createdAt])
  @@index([orderId, createdAt])
  @@index([paymentId, createdAt])
  @@index([refundId, createdAt])
}

model CatalogMatchReview {
  id                        String                   @id @default(cuid())
  sellerId                  String
  sellerOfferId             String?
  candidateCatalogProductId String?
  sellerSku                 String?                  @db.VarChar(80)
  proposedGtin              String?                  @db.VarChar(14)
  normalizedName            String?                  @db.VarChar(191)
  normalizedBrand           String?                  @db.VarChar(160)
  normalizedModel           String?                  @db.VarChar(160)
  matchStatus               CatalogMatchStatus
  reasonCode                String                   @db.VarChar(100)
  confidence                Decimal?                 @db.Decimal(5, 4)
  source                    String?                  @db.VarChar(50)
  externalSourceId          String?                  @db.VarChar(191)
  fingerprint               String?                  @db.Char(64)
  openFingerprint           String?                  @unique @db.Char(64)
  status                    CatalogMatchReviewStatus @default(PENDING)
  createdAt                 DateTime                 @default(now())
  updatedAt                 DateTime                 @updatedAt
  seller                    SellerProfile            @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  sellerOffer               SellerOffer?             @relation(fields: [sellerOfferId], references: [id], onDelete: SetNull)
  candidateCatalogProduct   CatalogProduct?          @relation(fields: [candidateCatalogProductId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([sellerId, status, createdAt])
  @@index([candidateCatalogProductId, status])
  @@index([sellerOfferId, status, createdAt])
}

model Order {
  id               String                @id @default(cuid())
  userId           String
  user             User                  @relation(fields: [userId], references: [id], onDelete: Restrict)
  orderNumber      String                @unique
  clientRequestId  String                @unique
  totalAmount      Decimal               @db.Decimal(12, 2)
  subtotalAmount   Decimal?              @db.Decimal(12, 2)
  discountAmount   Decimal               @default(0) @db.Decimal(12, 2)
  couponId         String?
  couponCode       String?               @db.VarChar(50)
  status           OrderStatus           @default(NEW)
  recipientName    String
  phone            String
  city             String
  district         String
  address          String
  postalCode       String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  items            OrderItem[]
  payment          Payment?
  payouts          SellerPayout[]
  refunds          Refund[]
  financialAudits  FinancialAuditEvent[]
  notifications    Notification[]
  shipments        Shipment[]
  coupon           Coupon?               @relation(fields: [couponId], references: [id], onDelete: SetNull)
  couponRedemption CouponRedemption?

  @@index([userId, createdAt])
}

model OrderItem {
  id               String                 @id @default(cuid())
  orderId          String
  productId        String
  sellerId         String
  catalogProductId String?
  sellerOfferId    String?
  productName      String
  productSku       String?                @db.VarChar(80)
  productImageUrl  String
  unitPrice        Decimal                @db.Decimal(12, 2)
  quantity         Int
  status           OrderStatus            @default(NEW)
  shippingCompany  String?
  trackingNumber   String?
  commissionRate   Decimal?               @db.Decimal(5, 4)
  commissionAmount Decimal?               @db.Decimal(12, 2)
  sellerNetAmount  Decimal?               @db.Decimal(12, 2)
  discountAmount   Decimal                @default(0) @db.Decimal(12, 2)
  order            Order                  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  statusHistory    OrderStatusHistory[]
  payout           SellerPayout?
  refunds          Refund[]
  ledgerEntries    FinancialLedgerEntry[]
  review           Review?
  shipmentItems    ShipmentItem[]
  product          Product                @relation(fields: [productId], references: [id], onDelete: Restrict)
  seller           SellerProfile          @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  catalogProduct   CatalogProduct?        @relation(fields: [catalogProductId], references: [id], onDelete: SetNull)
  sellerOffer      SellerOffer?           @relation(fields: [sellerOfferId], references: [id], onDelete: SetNull)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  @@index([sellerId, createdAt])
  @@index([orderId])
  @@index([catalogProductId])
  @@index([sellerOfferId])
}

model Shipment {
  id                  String         @id @default(cuid())
  orderId             String
  sellerId            String
  status              ShipmentStatus @default(NOT_READY)
  carrierCode         String?        @db.VarChar(40)
  carrierName         String?        @db.VarChar(100)
  trackingNumber      String?        @db.VarChar(80)
  preparedAt          DateTime?
  shippedAt           DateTime?
  deliveredAt         DateTime?
  cancelledAt         DateTime?
  estimatedDeliveryAt DateTime?
  idempotencyKey      String?        @unique @db.VarChar(191)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  order               Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  seller              SellerProfile  @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  items               ShipmentItem[]

  @@index([orderId, createdAt])
  @@index([sellerId, status, createdAt])
}

model ShipmentItem {
  id          String    @id @default(cuid())
  shipmentId  String
  orderItemId String
  quantity    Int
  createdAt   DateTime  @default(now())
  shipment    Shipment  @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  @@unique([shipmentId, orderItemId])
  @@index([orderItemId])
}

model Payment {
  id                String                @id @default(cuid())
  orderId           String                @unique
  provider          String                @default("TEST_PENDING")
  providerPaymentId String?               @unique
  idempotencyKey    String?               @unique @db.VarChar(120)
  amount            Decimal               @db.Decimal(12, 2)
  currency          String                @default("TRY") @db.VarChar(3)
  status            PaymentStatus         @default(PENDING)
  paymentMethod     String?               @db.VarChar(80)
  metadata          Json?
  paidAt            DateTime?
  failedAt          DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  order             Order                 @relation(fields: [orderId], references: [id], onDelete: Cascade)
  events            PaymentEvent[]
  refunds           Refund[]
  audits            FinancialAuditEvent[]

  @@index([status, createdAt])
  @@index([provider, createdAt])
}

model PaymentEvent {
  id              String   @id @default(cuid())
  paymentId       String
  provider        String   @db.VarChar(80)
  providerEventId String   @db.VarChar(191)
  eventType       String   @db.VarChar(100)
  payloadHash     String?  @db.VarChar(128)
  processedAt     DateTime @default(now())
  payment         Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@unique([provider, providerEventId])
  @@index([paymentId, processedAt])
}

model Refund {
  id                String                 @id @default(cuid())
  paymentId         String
  orderId           String
  orderItemId       String
  sellerId          String
  requestedByUserId String?
  idempotencyKey    String                 @unique @db.VarChar(120)
  providerRefundId  String?                @unique @db.VarChar(191)
  amount            Decimal                @db.Decimal(12, 2)
  currency          String                 @default("TRY") @db.VarChar(3)
  reason            String                 @db.VarChar(500)
  status            RefundStatus           @default(REQUESTED)
  requestedAt       DateTime               @default(now())
  completedAt       DateTime?
  updatedAt         DateTime               @updatedAt
  payment           Payment                @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  order             Order                  @relation(fields: [orderId], references: [id], onDelete: Restrict)
  orderItem         OrderItem              @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  seller            SellerProfile          @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  requestedBy       User?                  @relation("RefundRequester", fields: [requestedByUserId], references: [id], onDelete: SetNull)
  audits            FinancialAuditEvent[]
  ledgerEntries     FinancialLedgerEntry[]

  @@index([sellerId, status, requestedAt])
  @@index([orderId, requestedAt])
  @@index([paymentId, status])
}

model FinancialAuditEvent {
  id              String   @id @default(cuid())
  paymentId       String?
  refundId        String?
  orderId         String?
  actorUserId     String?
  entityType      String   @db.VarChar(50)
  entityId        String
  eventType       String   @db.VarChar(100)
  fromStatus      String?  @db.VarChar(50)
  toStatus        String?  @db.VarChar(50)
  source          String   @db.VarChar(50)
  externalEventId String?  @db.VarChar(191)
  createdAt       DateTime @default(now())
  payment         Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  refund          Refund?  @relation(fields: [refundId], references: [id], onDelete: SetNull)
  order           Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  actor           User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@unique([source, externalEventId])
  @@index([entityType, entityId, createdAt])
  @@index([orderId, createdAt])
}

model Notification {
  id        String              @id @default(cuid())
  userId    String?
  sellerId  String?
  orderId   String?
  type      String              @db.VarChar(80)
  channel   NotificationChannel @default(IN_APP)
  status    NotificationStatus  @default(PENDING)
  dedupeKey String              @unique @db.VarChar(191)
  title     String              @db.VarChar(160)
  message   String              @db.VarChar(500)
  metadata  Json?
  sentAt    DateTime?
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  user      User?               @relation(fields: [userId], references: [id], onDelete: Cascade)
  seller    SellerProfile?      @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  order     Order?              @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([userId, status, createdAt])
  @@index([sellerId, status, createdAt])
  @@index([status, createdAt])
}

model SellerPayout {
  id                String                 @id @default(cuid())
  sellerId          String
  orderId           String
  orderItemId       String                 @unique
  grossAmount       Decimal                @db.Decimal(12, 2)
  commissionAmount  Decimal                @db.Decimal(12, 2)
  providerFeeAmount Decimal                @default(0) @db.Decimal(12, 2)
  netAmount         Decimal                @db.Decimal(12, 2)
  currency          String                 @default("TRY") @db.VarChar(3)
  status            PayoutStatus           @default(PENDING)
  availableAt       DateTime?
  paidAt            DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  seller            SellerProfile          @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  order             Order                  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItem         OrderItem              @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  ledgerEntries     FinancialLedgerEntry[]

  @@index([sellerId, status, createdAt])
}

model FinancialLedgerEntry {
  id          String          @id @default(cuid())
  sellerId    String
  orderItemId String
  payoutId    String?
  refundId    String?
  dedupeKey   String?         @unique @db.VarChar(191)
  type        LedgerEntryType
  amount      Decimal         @db.Decimal(12, 2)
  currency    String          @default("TRY") @db.VarChar(3)
  createdAt   DateTime        @default(now())
  seller      SellerProfile   @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  orderItem   OrderItem       @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  payout      SellerPayout?   @relation(fields: [payoutId], references: [id], onDelete: SetNull)
  refund      Refund?         @relation(fields: [refundId], references: [id], onDelete: SetNull)

  @@index([sellerId, createdAt])
  @@index([orderItemId, type])
  @@index([refundId, createdAt])
}

model OrderStatusHistory {
  id              String       @id @default(cuid())
  orderItemId     String
  changedByUserId String?
  fromStatus      OrderStatus?
  toStatus        OrderStatus
  createdAt       DateTime     @default(now())
  orderItem       OrderItem    @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  changedBy       User?        @relation(fields: [changedByUserId], references: [id], onDelete: SetNull)

  @@index([orderItemId, createdAt])
  @@index([changedByUserId])
}

model CartItem {
  id               String          @id @default(cuid())
  userId           String
  productId        String
  catalogProductId String?
  sellerOfferId    String?
  quantity         Int             @default(1)
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  product          Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  catalogProduct   CatalogProduct? @relation(fields: [catalogProductId], references: [id], onDelete: Cascade)
  sellerOffer      SellerOffer?    @relation(fields: [sellerOfferId], references: [id], onDelete: Cascade)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@unique([userId, productId])
  @@index([userId])
  @@index([catalogProductId])
  @@index([sellerOfferId])
}

model Favorite {
  id               String          @id @default(cuid())
  userId           String
  productId        String
  catalogProductId String?
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  product          Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  catalogProduct   CatalogProduct? @relation(fields: [catalogProductId], references: [id], onDelete: Cascade)
  createdAt        DateTime        @default(now())

  @@unique([userId, productId])
  @@unique([userId, catalogProductId])
  @@index([userId])
  @@index([catalogProductId])
}

model Category {
  id              String           @id @default(cuid())
  name            String
  slug            String           @unique
  active          Boolean          @default(true)
  sortOrder       Int              @default(0)
  parentId        String?
  parent          Category?        @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children        Category[]       @relation("CategoryTree")
  products        Product[]
  catalogProducts CatalogProduct[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([active, sortOrder])
  @@index([parentId])
}

model Brand {
  id              String           @id @default(cuid())
  name            String
  slug            String           @unique
  active          Boolean          @default(true)
  products        Product[]
  catalogProducts CatalogProduct[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([active, name])
}

model Review {
  id               String          @id @default(cuid())
  userId           String
  productId        String
  catalogProductId String?
  orderItemId      String          @unique
  rating           Int
  comment          String          @db.VarChar(2000)
  status           ReviewStatus    @default(PENDING)
  moderationReason String?         @db.VarChar(500)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  product          Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  catalogProduct   CatalogProduct? @relation(fields: [catalogProductId], references: [id], onDelete: Cascade)
  orderItem        OrderItem       @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  @@unique([userId, productId])
  @@unique([userId, catalogProductId])
  @@index([productId, status, createdAt])
  @@index([status, createdAt])
  @@index([catalogProductId, status, createdAt])
}

model Coupon {
  id            String             @id @default(cuid())
  sellerId      String?
  code          String             @unique @db.VarChar(50)
  name          String             @db.VarChar(160)
  scope         CouponScope        @default(PLATFORM)
  discountType  CouponDiscountType
  discountValue Decimal            @db.Decimal(12, 2)
  maxDiscount   Decimal?           @db.Decimal(12, 2)
  minimumAmount Decimal?           @db.Decimal(12, 2)
  active        Boolean            @default(true)
  startsAt      DateTime?
  endsAt        DateTime?
  usageLimit    Int?
  usageCount    Int                @default(0)
  perUserLimit  Int                @default(1)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  seller        SellerProfile?     @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  orders        Order[]
  redemptions   CouponRedemption[]

  @@index([active, startsAt, endsAt])
  @@index([sellerId, active])
}

model CouponRedemption {
  id             String   @id @default(cuid())
  couponId       String
  userId         String
  orderId        String   @unique
  discountAmount Decimal  @db.Decimal(12, 2)
  createdAt      DateTime @default(now())
  coupon         Coupon   @relation(fields: [couponId], references: [id], onDelete: Restrict)
  user           User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@unique([couponId, userId])
  @@index([couponId, createdAt])
}

model AdminAuditLog {
  id          String   @id @default(cuid())
  actorUserId String
  action      String   @db.VarChar(100)
  entityType  String   @db.VarChar(50)
  entityId    String
  fromStatus  String?  @db.VarChar(50)
  toStatus    String?  @db.VarChar(50)
  note        String?  @db.VarChar(500)
  createdAt   DateTime @default(now())
  actor       User     @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId, createdAt])
  @@index([actorUserId, createdAt])
}
